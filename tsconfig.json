{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Les modules pures s'importent entre eux avec l'extension explicite :
    // c'est la seule forme que Node résout, et c'est ce qui permet de les
    // tester sans empaqueteur. Metro accepte les deux écritures.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "plugins",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
